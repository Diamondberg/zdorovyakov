{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": ".",
    "types": ["node"]
  },
  "include": ["apps/api/src/**/*.ts", "packages/contracts/src/**/*.ts", "db/**/*.ts", "tests/**/*.ts", "scripts/**/*.ts"]
}
