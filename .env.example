# Шаблон: секреты задаются только в локальном .env / хранилище секретов.
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3000
# Заполнить локально. Не публиковать connection string с учётными данными.
DATABASE_URL=
PUBLIC_API_BASE_URL=http://127.0.0.1:3000
STOREFRONT_ORIGIN=
SESSION_SECRET=
EMAIL_CODE_SECRET=
# На этапе разработки отправка отключена.
EMAIL_TRANSPORT=disabled
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Реальная акция не включается без утверждённых дат.
PROMOTION_ENABLED=false
PROMOTION_STARTS_AT=
PROMOTION_ENDS_AT=
ADMIN_ORIGIN=http://127.0.0.1:3000
# Only local HTTP development; production always forces Secure cookies.
ADMIN_INSECURE_LOCAL_COOKIE=false
ADMIN_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
